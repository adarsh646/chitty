RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# UPI Payment Configuration (Google Pay / PhonePe / Paytm / BHIM)
UPI_ID=yourname@okaxis
UPI_PAYEE_NAME="Chitty Society"

# Optional: Only needed if configuring server webhooks in Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=

# Mail & SMTP Notification Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_email@gmail.com
# For Gmail, generate a 16-character App Password (quotes recommended if contains spaces):
MAIL_PASSWORD="your app password here"
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="MSS Chitty"
MAIL_TO_ADDRESS=admin_recipient@example.com
APP_URL=http://localhost:8000