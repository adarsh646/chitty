# ==========================================
# Environment & Secret / Confidential Files
# ==========================================
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
credentials.json
client_secret*.json

# ==========================================
# Dependency Directories
# ==========================================
/vendor/
node_modules/

# ==========================================
# Logs & Debugging
# ==========================================
*.log
error_log
/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Cache & Temporary Files
# ==========================================
/cache/
/tmp/
*.tmp
*.temp

# ==========================================
# Database Backups & Dumps
# (Note: sql/schema.sql is tracked)
# ==========================================
dump.sql
*.dump
*.backup
*.bak
*.sql.gz

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
# IDE & Code Editor Configuration
# ==========================================
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ==========================================
# User Uploads / Storage (Optional)
# ==========================================
/uploads/*
!/uploads/.gitkeep
